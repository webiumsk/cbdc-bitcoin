# Vue Router (SPA): priamom vstupe na /sk, /es, … nasmeruj na index.html
# Hostinger (Apache / LiteSpeed s mod_rewrite)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
