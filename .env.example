# Skopíruj tento súbor ako `.env` v koreni projektu (`.env` sa necommituje).

# === Frontend (Vite) ===
# Zvýš po každej publikovanej zmene public/cbdc-data.json (cache bust pre /cbdc-data.json).
VITE_DATA_VERSION=2026-04-03

# === npm run update:data (Node skript ingest.mjs) ===
# Voliteľné: URL s JSON patchmi k krajinám. Ak prázdne, ingest sa preskočí a build len zlúči data/incoming/*.json + data/enrichment.json.
# CBDC_INGEST_URL=

# === npm run research:sources ===
# RESEARCH_FETCH_DELAY_MS=900
# RESEARCH_FETCH_TIMEOUT_MS=28000
# RESEARCH_USER_AGENT=cbdc.icu-research/1.0 (+https://cbdc.icu)
